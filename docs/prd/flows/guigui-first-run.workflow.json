  "cards": [
    {
      "dot": "violet",
      "title": "等待态铁律",
      "items": [
        "提交后按钮置灰+旋转,等待中不可重复点击",
        "双击等于并发跑两次注销→登录,属正确性问题",
        "仅验证成功才进庆祝页,失败就地内联报错"
      ]
    },
    {
      "dot": "rose",
      "title": "拒绝三态(2026-09-06 实测)",
      "items": [
        "userid error1 = 学号或运营商选错,核对一下",
        "userid error2 = 密码不对,改了再试",
        "bind userid error = 密码其实是对的,账号绑定被拦→指引自助服务平台"
      ]
    },
    {
      "dot": "amber",
      "title": "开门锚点 06:50",
      "items": [
        "开门前被拒不判密码错误,提示明早自动验证",
        "密码存未验证,不清可信度、不发通知",
        "校园实测 06:50 开门;锚点行为待真机窗口期复核"
      ]
    }
  ]
