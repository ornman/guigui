    "output": "docs/prd/flows/guigui-first-run.workflow.html",
    "views": [
      {
        "id": "main-path",
        "label": "提交到庆祝页",
        "focus": [
          "form",
          "busy",
          "probe",
          "logout",
          "flip",
          "login",
          "vaultbox",
          "success"
        ],
        "note": "主路:提交→等待态→探测→注销→翻转→真登→入库→庆祝页。"
      },
      {
        "id": "reject-recover",
        "label": "拒绝与恢复",
        "focus": [
          "login",
          "reject",
          "restore",
          "busy"
        ],
        "note": "被拒不入库,先恢复网络,改对再走一遍等待态。"
      },
      {
        "id": "degrade",
        "label": "降级与未验证",
        "focus": [
          "flip",
          "unverified",
          "success"
        ],
        "note": "门户不给注销翻转/网络中断时存未验证,明早首试真验证。"
      }
    ]
